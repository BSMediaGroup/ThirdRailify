{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thirdrailify-public-state",
  "main": "index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "THIRDRAILIFY_PUBLIC_STATE",
        "class_name": "ThirdRailifyPublicState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite-public-state",
      "new_sqlite_classes": ["ThirdRailifyPublicState"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "THIRDRAILIFY_COMMUNITY_KV",
      "id": "a06d11f8339b429db2f5718f67241c2e"
    }
  ]
}

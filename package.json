{
  "name": "thirdrailify-v2-public",
  "private": true,
  "version": "0.1.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:functions": "node --test tests/community-functions.test.mjs tests/watch-functions.test.mjs tests/state-do.test.mjs tests/kv-write-budget.test.mjs tests/auth-functions.test.mjs",
    "test:storefront": "node --test tests/storefront-commerce.test.mjs",
    "test:kv-ban": "node scripts/assert-no-kv-mutations.mjs",
    "test:state-budget": "node scripts/state-backend-budget.mjs",
    "test:state-fingerprint": "node scripts/state-backend-fingerprint.mjs --check",
    "verify:state-backend": "node scripts/verify-cloudflare-state-backend.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.19",
    "wrangler": "4.60.0"
  }
}

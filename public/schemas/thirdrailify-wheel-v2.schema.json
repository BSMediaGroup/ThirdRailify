{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thirdrailify.com/schemas/thirdrailify-wheel-v2.schema.json",
  "title": "Third Railify portable wheel v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "generator", "source", "wheel", "integrity"],
  "properties": {
    "format": { "const": "thirdrailify-wheel" },
    "formatVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "Third Railify" }, "version": { "type": "string", "maxLength": 40 } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["slug"], "properties": { "slug": { "type": "string", "maxLength": 80 } } },
    "wheel": { "$ref": "#/$defs/wheel" },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["algorithm", "wheelPayload"], "properties": { "algorithm": { "const": "SHA-256" }, "wheelPayload": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "style": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode", "color"], "properties": { "mode": { "const": "solid" }, "color": { "$ref": "#/$defs/hex" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "color", "pattern", "patternColor"], "properties": { "mode": { "const": "pattern" }, "color": { "$ref": "#/$defs/hex" }, "pattern": { "enum": ["diagonal-stripes", "reverse-stripes", "zigzag", "dots", "checkers", "triangles", "chevrons", "waves", "third-rail-bolts"] }, "patternColor": { "$ref": "#/$defs/hex" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "color", "imageAssetRef"], "properties": { "mode": { "const": "image" }, "color": { "$ref": "#/$defs/hex" }, "imageAssetRef": { "type": "string", "pattern": "^segment-[a-f0-9]{12,64}$" } } }
      ]
    },
    "wheel": { "type": "object", "additionalProperties": false, "required": ["title", "description", "settings", "entries", "media"], "properties": {
      "title": { "type": "string", "minLength": 1, "maxLength": 100 }, "description": { "type": "string", "maxLength": 280 }, "settings": { "$ref": "#/$defs/settings" },
      "entries": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } },
      "media": { "type": "object", "additionalProperties": false, "required": ["background", "center", "segments"], "properties": { "background": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/media" }] }, "center": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/media" }] }, "segments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/segmentMedia" } } } }
    } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["label", "weight", "color", "style", "active", "order"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "weight": { "type": "integer", "minimum": 1, "maximum": 100000 }, "color": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hex" }] }, "style": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/style" }] }, "active": { "type": "boolean" }, "order": { "type": "integer", "minimum": 0, "maximum": 999 } } },
    "settings": { "type": "object", "additionalProperties": false, "required": ["themePreset", "palette", "paletteStyles", "pointerAccent", "centreTreatment", "backgroundIntensity", "labelContrast", "spinDurationMs", "tickingSoundEnabled", "spinSoundPreset", "winnerSoundEnabled", "winnerSoundPreset", "celebrationEnabled", "confettiEnabled", "fireworksEnabled", "winnerLightingEnabled", "celebrationIntensity", "backgroundEnabled", "backgroundFocalX", "backgroundFocalY", "backgroundImageOpacity", "backgroundOverlayIntensity", "winnerMessageTemplate", "publicHistoryVisible"], "properties": {
      "themePreset": { "enum": ["third-rail-gold", "live-wire-red", "gina-violet", "high-voltage-mono", "signal-teal", "after-hours", "high-voltage-hazard", "rail-strike", "goated-circuit", "night-signal", "custom"] }, "palette": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/hex" } }, "paletteStyles": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/style" } }, "pointerAccent": { "$ref": "#/$defs/hex" }, "centreTreatment": { "enum": ["bolt", "signal", "ring"] }, "backgroundIntensity": { "enum": ["low", "medium", "high"] }, "labelContrast": { "enum": ["light", "dark"] }, "spinDurationMs": { "type": "integer", "minimum": 2000, "maximum": 20000 }, "tickingSoundEnabled": { "type": "boolean" }, "spinSoundPreset": { "enum": ["classic-tick", "relay-click", "arc-pulse", "mechanical-ratchet", "soft-tick", "silent"] }, "winnerSoundEnabled": { "type": "boolean" }, "winnerSoundPreset": { "enum": ["gold-rise", "broadcast-hit", "voltage-chime", "crimson-impact", "synth-fanfare", "short-burst", "silent"] }, "celebrationEnabled": { "type": "boolean" }, "confettiEnabled": { "type": "boolean" }, "fireworksEnabled": { "type": "boolean" }, "winnerLightingEnabled": { "type": "boolean" }, "celebrationIntensity": { "enum": ["subtle", "normal", "strong"] }, "backgroundEnabled": { "type": "boolean" }, "backgroundFocalX": { "type": "integer", "minimum": 0, "maximum": 100 }, "backgroundFocalY": { "type": "integer", "minimum": 0, "maximum": 100 }, "backgroundImageOpacity": { "type": "integer", "minimum": 0, "maximum": 100 }, "backgroundOverlayIntensity": { "type": "integer", "minimum": 0, "maximum": 100 }, "winnerMessageTemplate": { "type": "string", "minLength": 1, "maxLength": 160 }, "publicHistoryVisible": { "type": "boolean" }
    } },
    "media": { "type": "object", "additionalProperties": false, "required": ["mode", "fileName", "mimeType", "sha256", "base64"], "properties": { "mode": { "const": "embedded" }, "assetRef": { "type": "string", "pattern": "^segment-[a-f0-9]{12,64}$" }, "fileName": { "type": "string", "minLength": 1, "maxLength": 120 }, "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/bmp", "image/gif", "image/svg+xml"] }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "base64": { "type": "string", "contentEncoding": "base64" } } },
    "segmentMedia": { "allOf": [{ "$ref": "#/$defs/media" }, { "type": "object", "required": ["assetRef"], "properties": { "assetRef": { "type": "string", "pattern": "^segment-[a-f0-9]{12,64}$" }, "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/bmp", "image/gif", "image/svg+xml"] } } }] }
  }
}

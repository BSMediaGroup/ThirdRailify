{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thirdrailify:wheel:1",
  "title": "Third Railify portable wheel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "generator", "source", "wheel", "integrity"],
  "properties": {
    "format": { "const": "thirdrailify-wheel" },
    "formatVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "Third Railify" }, "version": { "type": "string", "maxLength": 100 } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": { "slug": { "type": "string", "maxLength": 80, "description": "Informational only; never imported as authority." } }
    },
    "wheel": { "$ref": "#/$defs/wheel" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "wheelPayload"],
      "properties": { "algorithm": { "const": "SHA-256" }, "wheelPayload": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "settings", "entries", "media"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 280 },
        "settings": { "$ref": "#/$defs/settings" },
        "entries": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "center"],
          "properties": { "background": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/media" }] }, "center": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/media" }] } }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "weight", "color", "active", "order"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "color": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hex" }] },
        "active": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0, "maximum": 999 }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themePreset", "palette", "pointerAccent", "centreTreatment", "backgroundIntensity", "labelContrast", "spinDurationMs", "tickingSoundEnabled", "winnerSoundEnabled", "celebrationEnabled", "confettiEnabled", "winnerLightingEnabled", "celebrationIntensity", "backgroundEnabled", "backgroundFocalX", "backgroundFocalY", "backgroundImageOpacity", "backgroundOverlayIntensity", "winnerMessageTemplate", "publicHistoryVisible"],
      "allOf": [{ "if": { "properties": { "themePreset": { "const": "custom" } }, "required": ["themePreset"] }, "then": { "properties": { "palette": { "minItems": 1, "maxItems": 5 } } }, "else": { "properties": { "palette": { "minItems": 2, "maxItems": 12 } } } }],
      "properties": {
        "themePreset": { "enum": ["third-rail-gold", "live-wire-red", "gina-violet", "high-voltage-mono", "signal-teal", "after-hours", "custom"] },
        "palette": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/hex" } },
        "pointerAccent": { "$ref": "#/$defs/hex" },
        "centreTreatment": { "enum": ["bolt", "signal", "ring"] },
        "backgroundIntensity": { "enum": ["low", "medium", "high"] },
        "labelContrast": { "enum": ["light", "dark"] },
        "spinDurationMs": { "type": "integer", "minimum": 2000, "maximum": 20000 },
        "tickingSoundEnabled": { "type": "boolean" },
        "winnerSoundEnabled": { "type": "boolean" },
        "celebrationEnabled": { "type": "boolean" },
        "confettiEnabled": { "type": "boolean" },
        "fireworksEnabled": { "type": "boolean" },
        "winnerLightingEnabled": { "type": "boolean" },
        "celebrationIntensity": { "enum": ["subtle", "normal", "strong"] },
        "backgroundEnabled": { "type": "boolean" },
        "backgroundFocalX": { "type": "integer", "minimum": 0, "maximum": 100 },
        "backgroundFocalY": { "type": "integer", "minimum": 0, "maximum": 100 },
        "backgroundImageOpacity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "backgroundOverlayIntensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "winnerMessageTemplate": { "type": "string", "minLength": 1, "maxLength": 160 },
        "publicHistoryVisible": { "type": "boolean" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fileName", "mimeType", "sha256", "base64"],
      "properties": {
        "mode": { "const": "embedded" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 84 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/bmp", "image/svg+xml"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "base64": { "type": "string", "contentEncoding": "base64" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thirdrailify.com/schemas/thirdrailify-stage-v1.schema.json",
  "title": "Third Railify Stage V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "generator", "stage", "wheels", "media", "integrity"],
  "properties": {
    "format": { "const": "thirdrailify-stage" },
    "formatVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "Third Railify" }, "version": { "type": "string" } }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "layout", "slots"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 280 },
        "layout": { "type": "object", "additionalProperties": false, "required": ["maxWheels"], "properties": { "maxWheels": { "const": 6 } } },
        "slots": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/slot" } }
      }
    },
    "wheels": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/wheel" } },
    "media": { "type": "object", "additionalProperties": false, "required": ["assets"], "properties": { "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } } } },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["algorithm", "stagePayload"], "properties": { "algorithm": { "const": "SHA-256" }, "stagePayload": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  },
  "$defs": {
    "slot": { "type": "object", "additionalProperties": false, "required": ["order", "wheelKey"], "properties": { "order": { "type": "integer", "minimum": 0, "maximum": 5 }, "wheelKey": { "type": "string", "pattern": "^wheel-[1-6]$" } } },
    "wheel": { "type": "object", "additionalProperties": false, "required": ["key", "portableWheel"], "properties": { "key": { "type": "string", "pattern": "^wheel-[1-6]$" }, "portableWheel": { "type": "object" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["key", "fileName", "mimeType", "sha256", "base64"], "properties": { "key": { "type": "string", "pattern": "^asset-[a-f0-9]{20}$" }, "fileName": { "type": "string" }, "mimeType": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "base64": { "type": "string", "contentEncoding": "base64" } } }
  }
}
